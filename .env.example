# Default: local JSON vector store, no Pinecone required.
VECTOR_STORE=auto
LOCAL_VECTOR_STORE_PATH=.pr-context-engine/vector-store.json

# Optional: improves GitHub rate limits and enables private repositories.
GITHUB_AUTH_TOKEN=

# Optional production backend. Set VECTOR_STORE=pinecone to force it.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=pr-context-engine
