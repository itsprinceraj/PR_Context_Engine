{
  "name": "pr-context-engine",
  "version": "1.0.0",
  "description": "MCP server that gives AI PR reviewers repository memory using local or Pinecone vector search",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pr-context-engine": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pull-request",
    "code-review",
    "rag",
    "embeddings",
    "github"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/**/*.test.ts",
    "eval:retrieval": "tsx src/cli/evaluateRetrieval.ts",
    "prepack": "npm test && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@octokit/rest": "^20.0.0",
    "@pinecone-database/pinecone": "^2.0.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.4.2",
    "joi": "^18.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
